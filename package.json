{
  "name": "infinyx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:gateway": "tsc -p tsconfig.gateway.json",
    "test:sql": "bash tests/sql/run.sh",
